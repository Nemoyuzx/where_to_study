{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Business commands required by the main application window",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-get-metadata",
    "allow-load-saved-settings",
    "allow-save-saved-settings",
    "allow-clear-local-data",
    "allow-load-saved-schedule",
    "allow-load-saved-schedule-for-scope",
    "allow-load-saved-classrooms",
    "allow-load-saved-classrooms-for-scope",
    "allow-fetch-schedule",
    "allow-import-schedule-to-calendar",
    "allow-import-favorite-deadlines-to-calendar",
    "allow-fetch-classrooms",
    "allow-fetch-holidays",
    "allow-fetch-weather",
    "allow-fetch-almanac",
    "allow-fetch-deadlines",
    "allow-fetch-assignments",
    "allow-fetch-deadline-calendar",
    "allow-fetch-custom-deadline-calendar",
    "allow-fetch-assignment-calendar"
  ]
}
