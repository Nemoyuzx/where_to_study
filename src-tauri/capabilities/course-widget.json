{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "course-widget",
  "description": "Read-only schedule access required by the desktop course widget",
  "windows": ["course-widget"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-metadata",
    "allow-load-saved-schedule",
    "allow-load-saved-schedule-for-scope",
    "allow-hide-desktop-widget"
  ]
}
