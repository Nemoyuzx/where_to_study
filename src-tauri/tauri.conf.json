{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Where To Study",
  "version": "0.1.5",
  "identifier": "com.nemoyu.wheretostudy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Where To Study",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["main", "course-widget"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.html": "THIRD_PARTY_LICENSES.html",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "android": {
      "versionCode": 1005
    }
  }
}
