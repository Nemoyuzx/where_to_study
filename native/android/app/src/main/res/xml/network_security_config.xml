<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Credential-bearing requests remain HTTPS-only and trust only the
         platform CA set so user-installed roots cannot MITM login. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
