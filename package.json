{
  "name": "where-to-study",
  "private": true,
  "version": "0.2.5",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test test/*.test.js",
    "licenses:generate": "node scripts/generate-third-party-licenses.mjs",
    "licenses:check": "node scripts/generate-third-party-licenses.mjs --check",
    "icons:sync": "./scripts/sync-app-icons.sh",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --features custom-protocol",
    "tauri:build:linux": "tauri build --features custom-protocol --bundles deb,appimage --ci",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc --features custom-protocol --bundles nsis --ci",
    "native:android:build": "./scripts/native-android-build.sh",
    "native:android:sign:init": "./scripts/native-android-signing-init.sh",
    "native:android:package": "./scripts/native-android-package.sh",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build --features custom-protocol",
    "tauri:ios:build:unsigned": "./scripts/ios-build-local.sh",
    "tauri:ios:build:signed": "./scripts/ios-build-signed.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "spdx-license-list": "6.12.0",
    "vite": "^8.2.2"
  }
}
